      "Edit(~/.copilot/permissions-config.json)",
      "Edit(~/.copilot/settings.json)",
      "Edit(~/.copilot/copilot-instructions.md)",
      "Edit(~/.copilot/mcp-config.json)",
      "Edit(~/.gemini/config/mcp_config.json)",
      "Edit(~/Library/Application Support/Code/User/mcp.json)",
      "Edit(~/.config/Code/User/mcp.json)",
      "Edit(~/.gemini/antigravity-cli/settings.json)",
      "Edit(~/.gemini/config/hooks.json)",
      "Edit(~/.gemini/GEMINI.md)",
      "Edit(/{{AI_MEMORY_ROOT}}/policy/**)",
