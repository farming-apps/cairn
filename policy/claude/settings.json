      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/.gemini/**)",
      "Edit(~/.config/gh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"{{AI_MEMORY_ROOT}}/tools/guard-bash.py\" # ai-memory",
            "timeout": 5,
            "onFailure": "block",
            "statusMessage": "guard-bash"
          }
        ]
      }
    ]
  }
}
