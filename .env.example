# Variables read by the scripts in tools/. NAMES only; values live in your shell or Keychain.
# No script loads this file: export what you need in ~/.zshrc or similar.
# Claude Code and Gemini CLI use their own login; they need no key here.

# sanitize.py, install.sh, doctor.sh: per-machine local config (forbidden terms)
AI_MEMORY_LOCAL=

# tools/ai: local models or any OpenAI-compatible endpoint
AI_ENDPOINT=   # if unset, uses $OLLAMA_HOST/v1
AI_MODEL=                               # model name on the server, required
AI_API_KEY_VAR=                         # NAME of the variable holding the key, if the endpoint requires one
OLLAMA_HOST=

# The LiteLLM gateway variables (phase 2) are documented in gateway/litellm-config.yaml.
